---
import ThemeSwitcher from "@/components/ui/theme-switcher.astro";
import Layout from "@/layouts/base.astro";
---

<Layout title="Login" noSwitcher>
  <section class="container">
    <ThemeSwitcher class="theme-switcher" />
    <h1>Sign in</h1>
    <form onsubmit="return false;" id="login-form">
      <input
        type="text"
        name="username"
        placeholder="Username"
        aria-label="Username"
        autocomplete="username"
        required
      />
      <input
        type="password"
        name="password"
        placeholder="Password"
        aria-label="Password"
        autocomplete="current-password"
        required
      />
      <button type="submit">Login</button>
      <article
        role="alert"
        aria-live="assertive"
        aria-atomic="true"
        aria-hidden="true"
      >
        Invalid username or password
      </article>
    </form>
    <div id="sso" hidden>
      <p class="divider">or</p>
      <a id="sso-link" role="button" href="/api/dashboard/auth/oidc/login"
        >Sign in with SSO</a
      >
    </div>
  </section>
</Layout>

<script>
  import { api } from "@/api/client";
  import { queryClient } from "@/api/query";
  import { runtimeConfig } from "@/config";

  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("login-form") as HTMLFormElement;
    const alert = form?.querySelector("#login-form article") as HTMLElement;

    // Surface any ?error= returned by the OIDC callback. The raw code is never
    // rendered — only mapped messages, assigned via textContent.
    const errorCode = new URLSearchParams(window.location.search).get("error");
    if (errorCode && alert) {
      const messages: Record<string, string> = {
        registration_closed: "New account registration is currently closed.",
        domain_not_allowed: "Accounts can only be created with an approved email domain.",
        email_not_verified: "Your account couldn't be created — a verified email address is required.",
      };
      alert.textContent =
        messages[errorCode] ?? "Sign-in failed. Please try again or use your password.";
      alert.setAttribute("aria-hidden", "false");
    }

    // Reveal the SSO button when the backend reports OIDC is enabled.
    if (runtimeConfig?.oidcEnabled) {
      const sso = document.getElementById("sso");
      const link = document.getElementById("sso-link");
      if (link && runtimeConfig.oidcButtonLabel)
        link.textContent = runtimeConfig.oidcButtonLabel;
      sso?.removeAttribute("hidden");
    }

    if (!form || !alert) return;

    form.onsubmit = (e) => {
      e.preventDefault();
      e.stopPropagation();
      alert.setAttribute("aria-hidden", "true");

      const formData = new FormData(form);
      const { username, password } = Object.fromEntries(formData.entries()) as {
        username: string;
        password: string;
      };

      api["/api/dashboard/auth/login"]
        .post({ json: { username, password } })
        .then((res) => {
          if (!(res as { ok: boolean })?.ok)
            return Promise.reject(new Error("Invalid username or password"));
          queryClient.clear();
          document.location.href = "/";
        })
        .catch((_) => {
          alert.setAttribute("aria-hidden", "false");
        });

      return false;
    };
  });
</script>

<style>
  .theme-switcher {
    position: absolute;
    padding: 1rem;
    top: 0;
    right: 0;
  }

  #sso {
    margin-top: 1rem;
    text-align: center;
  }

  #sso .divider {
    color: var(--pico-muted-color, #888);
    margin: 0.75rem 0;
  }

  section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 25rem;
    height: 100%;

    #login-form {
      position: relative;
    }

    article {
      position: absolute;
      display: none;
      color: rgb(255, 85, 85);
      width: 100%;
      text-align: center;

      &[aria-hidden="false"] {
        display: block;
      }
    }
  }
</style>
