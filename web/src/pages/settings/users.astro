---
import { CreateUser, UsersTable } from "@/components/settings/users";
import Settings from "@/layouts/settings.astro";
---

<Settings title="Users">
  <nav>
    <h1>Users</h1>
    <CreateUser client:only="react" />
  </nav>
  <p class="description">
    Manage dashboard access and administrator roles. Single sign-on providers
    are configured in the config file, under <code>[oidc.providers]</code>.
  </p>
  <UsersTable client:load />
</Settings>

<style>
  .description {
    max-width: 46rem;
    margin-bottom: 1rem;
    color: var(--pico-muted-color);
  }
</style>
