---
import { CreateUser, UsersTable } from "@/components/settings/users";
import Settings from "@/layouts/settings.astro";
---

<Settings title="Users">
  <nav class="list-header">
    <h1>Users</h1>
    <CreateUser client:only="react" />
  </nav>
  <p class="description">
    Manage administrator roles. Assign project access in <a href="/settings/teams">Teams</a>. Single sign-on providers
    are configured in the config file, under <code>[oidc.providers]</code>. When a provider has a group mapping, the
    teams of its SSO-only accounts come from that mapping and are replaced at each sign-in.
  </p>
  <UsersTable client:load />
</Settings>
